/* The resources that carry MacMusic's version (1.0 Part A). Generated by
   CMake from resources/version.r.in into the build folder: the version is
   set only by project(... VERSION ...) in CMakeLists.txt. */

#include "MacTypes.r"

/* The Finder's Get Info shows vers 1 as the version; vers 2 names the
   product the file belongs to. \0xA9 is the Mac Roman copyright sign. */
resource 'vers' (1) {
    @VERS_MAJOR@, @VERS_MINOR@, release, 0x00, verUS,
    "@PROJECT_VERSION@",
    "@PROJECT_VERSION@, \0xA9 2026 Jack McAteer"
};

resource 'vers' (2) {
    @VERS_MAJOR@, @VERS_MINOR@, release, 0x00, verUS,
    "@PROJECT_VERSION@",
    "MacMusic @PROJECT_VERSION@"
};

/* The signature resource: MacMusic's creator code, with its name and
   version (Fix 1). */
type 'iPdM' { pstring; };

resource 'iPdM' (0, "Owner resource") {
    "MacMusic @PROJECT_VERSION@"
};
